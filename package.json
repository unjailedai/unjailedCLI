{
  "name": "unjailed",
  "version": "0.12.4",
  "description": "Unjailed AI in your terminal \u2014 streaming chat and coding agent CLI for unjailedai.com, with tools, subagents, workflows, goals and loops",
  "type": "module",
  "bin": {
    "unjailed": "dist/index.js"
  },
  "files": [
    "dist",
    "logo.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "dev": "npm run build && node dist/index.js",
    "start": "node dist/index.js",
    "mock": "node mock/server.mjs",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "cli",
    "chat",
    "terminal",
    "openai-compatible",
    "unjailed",
    "llm",
    "agent",
    "coding-agent",
    "subagents",
    "workflow"
  ],
  "homepage": "https://unjailedai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unjailedai/unjailedCLI.git"
  },
  "bugs": {
    "url": "https://github.com/unjailedai/unjailedCLI/issues"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "ink": "^6.8.0",
    "react": "^19.3.0",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
